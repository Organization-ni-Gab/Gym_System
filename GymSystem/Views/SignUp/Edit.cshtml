@model Signup
<h2>Edit Customer</h2>

<form method="post" class="form-control bg-light was-validated">
	<div class="container">
		<br />
		<div class="form-group col-md-4" >
			<div  class="input-group" >
				<span class="input-group-text" id="customerId">Customer ID: </span>
				<input asp-for="CustomerID" aria-describedby="customerId" class=" align-content-center bg-dark fw-semibold text-white text-center" readonly />

			</div>
		</div>
		<br />
		<div class="row">
			<div class="form-group col-md-4">
				<label>First Name</label>
				<input asp-for="FirstName" class="form-control align-content-center bg-dark fw-semibold text-white text-center" required />
		
			</div>

			<div class="form-group col-md-4">
				<label>Middle Name</label>
				<input asp-for="MiddleName" class="form-control align-content-center bg-dark fw-semibold text-white text-center" required />
		
			</div>

			<div class="form-group col-md-4">
				<label>Last Name</label>
				<input asp-for="LastName" class="form-control align-content-center bg-dark fw-semibold text-white text-center" required />
		
			</div>
		</div>
		<br />
		<br />
		<div class="row">
			<div class="form-group col-md-4">
				<label>Contact Number</label>
				<input asp-for="ContactNumber" class="form-control align-content-center bg-dark fw-bold text-white text-center" required />
		
			</div>

			<div class="form-group col-md-4">
				<label for="Gender">Gender</label>
				<select class="form-select align-content-center bg-dark fw-bold text-white text-center" asp-for="Gender" required>
					<option value="">select gender</option>
					<option value="Male">Male</option>
					<option value="Female">Female</option>
				</select>
		
			</div>

			<div class="form-group col-md-4">
				<label for="isMember">Select Options</label>
				<select class="form-select align-content-center bg-dark fw-bold text-white text-center" asp-for="isMember" required>
					<option value="">select type</option>
					<option value=1>for Membership</option>
					<option value=0>Walk-In</option>
				</select>
		
			</div>
		</div>

		<br />
		<button type="submit" class="btn btn-warning">Update Record</button>
		<br />
		<br />

	</div>

</form>