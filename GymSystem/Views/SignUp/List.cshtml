@model IEnumerable<Signup>

@{
	ViewData["Title"] = "SignUp";
}
<h2>Sign-up List</h2>



<form asp-controller="SignUp" method="post">
	<a asp-controller="Signup" asp-action="Create" class="btn btn-primary w-15 ">Add Client</a>
	<button  class="btn btn-danger w-15 m-1" asp-action="Delete" onsubmit="return confirm ('Are you sure you want to delete?');">Delete</button>

	<table class="table table-striped">
		<thead class="bg-dark text-white">
			<tr>
				<th>Select</th>
				<th>ID</th>
				<th>First Name</th>
				<th>Middle Name</th>
				<th>Last Name</th>
				<th>Contact Number</th>
				<th>Gender</th>
				<th>Date Created</th>
				<th>Type</th>
				<th>Action</th>
			</tr>
		</thead>
		<tbody>
			@foreach(var customer in Model)
			{
				<tr>
					<th><input type="checkbox" name="checkboxID" value="@customer.CustomerID" /></th>
					<td>@customer.CustomerID</td>
					<td>@customer.FirstName</td>
					<td>@customer.MiddleName</td>
					<td>@customer.LastName</td>
					<td>@customer.ContactNumber</td>
					<td>@customer.Gender</td>
					<td>@customer.JoinDate</td>
					@if (customer.isMember == 0)
					{
						<td>walk in</td>
					}
					else
					{
						<td>Membered</td>
					}
					<td><a asp-controller="Signup" asp-action="Edit" asp-route-id="@customer.CustomerID" class="btn btn-warning">Edit</a></td>
				@* <td>
					<div></div>
				</td>  CREATE AJAX ACTION FOR EDIT,WALKIN,MEMBERSHIP*@
			</tr>
		}
	</tbody>
</table>
</form>
<br />
<br />
<br />
<h6>@ViewBag.Message</h6>
