@model Signup
<h2>Add Customer</h2>

<form class="Create" method="post" class="gap-3">
	<div class="container">
		<div class="row">
			<div class="form-group col-md-4">
				<label>First Name</label>
				<input asp-for="FirstName" class="form-control " />
				<span asp-validation-for="FirstName"></span>
			</div>

			<div class="form-group col-md-4">
				<label>Middle Name</label>
				<input asp-for="MiddleName" class="form-control" />
				<span asp-validation-for="MiddleName"></span>
			</div>

			<div class="form-group col-md-4">
				<label>Last Name</label>
				<input asp-for="LastName" class="form-control" />
				<span asp-validation-for="LastName"></span>
			</div>
		</div>
	
		<div class="row">
			<div class="form-group col-md-4">
				<label>Contact Number</label>
				<input asp-for="ContactNumber" class="form-control" />
				<span asp-validation-for="ContactNumber"></span>
			</div>

			<div class="form-group col-md-4">
				<label>Gender</label>
				</br>
				<select class="form-group col-md-4" asp-for="Gender">
					<option value="">select gender</option>
					<option value="Male">Male</option>
					<option value="Female">Female</option>
				</select>
				<span asp-validation-for="Gender"></span>
			</div>

			<div class="form-group col-md-4">
				<label>Select Options</label>
				</br>
				<select class="form-group col-md-4" asp-for="isMember">
					<option value="">select type</option>
					<option value=1>for Membership</option>
					<option value=0>Walk-In</option>
				</select>
				<span asp-validation-for="isMember"></span>
			</div>
		</div>

		<br />
				<button type="submit" class="btn btn-primary">Add Client</button>
		
	</div>
	
</form>